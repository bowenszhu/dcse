{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make release",
            "type": "shell",
            "command": "export PYTHON_IFLAGS=`python3-config --includes`;make -j 16",
            "options": {
                "cwd": "${workspaceFolder}/src/engines"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}/src/engines"
                ]
            }
        },
        {
            "label": "make gpu release",
            "type": "shell",
            "command": "export PYTHON_IFLAGS=`python3-config --includes`;make gpu -j 16",
            "options": {
                "cwd": "${workspaceFolder}/src/engines"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceRoot}/src/engines"
                ],
                "pattern": {
                    "regexp": "(.+)\\((\\d+)\\): (error|warning): (.+)",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "make clean",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}/src/engines"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}